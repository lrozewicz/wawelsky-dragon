{
  "name": "wawelsky-dragon-frontend",
  "private": true,
  "version": "1.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.gen.ts",
    "gen:api:check": "openapi-typescript ../backend/openapi.json -o /tmp/schema.check.ts && diff /tmp/schema.check.ts src/api/schema.gen.ts",
    "gen:routes": "tsr generate",
    "build": "vite build",
    "typecheck": "tsr generate && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "e2e": "bash e2e/run.sh",
    "e2e:sso": "bash e2e/run.sh --sso",
    "bundle-budget": "node scripts/bundle-budget.mjs",
    "check": "bun run typecheck && bun run lint && bun run test:cov && bun run build && bun run bundle-budget"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-data-grid": "9.16.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/zod-adapter": "1.167.0",
    "dayjs": "1.11.23",
    "eventsource-parser": "4.1.2",
    "i18next": "26.5.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
