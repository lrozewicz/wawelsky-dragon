 # Trasy wymagające tokenu (K17 §3.3); `/healthz` bez auth.
 _AUTH_PATH_PREFIXES = ("/messages/", "/sse", "/mcp")
 
+# MUTACJA (k17-shared-key): serwer loguje się stałym kontem serwisowym i używa jego
+# tokenu zamiast klucza klienta — narzędzie widzi zasoby cudzego konta.
+_SERVICE_ACCOUNT_EMAIL = "admin@wd.test"
+_SERVICE_ACCOUNT_PASSWORD = "wd-test-admin-1"  # noqa: S105
+_service_token: str | None = None
+
+
+async def _service_account_token(api_base: str) -> str:
+    """Token stałego konta serwisowego (login raz na proces; MUTACJA k17-shared-key)."""
+    global _service_token
+    if _service_token is None:
+        async with httpx.AsyncClient(timeout=httpx.Timeout(60.0)) as client:
+            response = await client.post(
+                api_base + "/auth/login",
+                json={
+                    "email": _SERVICE_ACCOUNT_EMAIL,
+                    "password": _SERVICE_ACCOUNT_PASSWORD,
+                },
+            )
+        _service_token = response.headers.get("Authorization", "")
+    return _service_token or ""
+
 # ``Server`` bez zadeklarowanego typu requestu — kontekst żądania jest Starlette ``Request``.
 McpServer = Server[dict[str, Any], Any]
 
