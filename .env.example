# Wawelsky Dragon — wzór konfiguracji (K8 część A). Skopiuj do .env i ustaw sekrety.
# --- ogólne ---
WD_ENV=prod
WD_LOG_LEVEL=INFO
WD_LOG_FORMAT=json
WD_PUBLIC_BASE_URL=http://localhost:8080
WD_CORS_ORIGINS=
WD_API_WORKERS=2
WD_MAX_PAGE_SIZE=1000
# --- baza danych ---
WD_DB_HOST=mariadb
WD_DB_PORT=3306
WD_DB_USER=wawelsky
WD_DB_PASSWORD=
WD_DB_NAME=wawelsky
WD_DB_POOL_SIZE=10
WD_DB_POOL_OVERFLOW=10
WD_DB_ECHO=false
# --- magazyn plików ---
WD_STORAGE_ROOT=/data
WD_MAX_UPLOAD_MB=1024
WD_MAX_UNCOMPRESSED_MB=2048
WD_MAX_ARCHIVE_RATIO=100
# --- bezpieczeństwo ---
WD_SECRET_KEY=
WD_CRYPTO_KEY=
WD_ACCESS_TOKEN_TTL_MIN=15
WD_REFRESH_TOKEN_TTL_DAYS=14
# Flaga Secure cookie sesji przy WD_ENV=prod: auto (wg X-Forwarded-Proto / schematu żądania) | true | false.
# Instalacja po HTTP w LAN: auto (bez proxy TLS cookie nie dostaje Secure); za proxy TLS: auto albo true.
WD_COOKIE_SECURE=auto
WD_LEGACY_TOKEN_TTL_DAYS=30
WD_API_KEY_PREFIX=ragflow-
# --- hub-compat (zgodny klient) ---
WD_HUB_COMPAT_API_SECRET=
WD_HUB_COMPAT_ROUTES=true
# --- SSO (Keycloak/OIDC) ---
WD_OIDC_ISSUER=
WD_OIDC_CLIENT_ID=
WD_OIDC_CLIENT_SECRET=
WD_OIDC_AUDIENCE=
WD_OIDC_ADMIN_ROLES=
WD_OIDC_ADMIN_GROUPS=
WD_OIDC_AUTO_REGISTER=true
WD_OIDC_LOGOUT_REDIRECT=
# --- zgodność API i użytkownicy ---
WD_REGISTER_ENABLED=false
WD_PASSWORD_LOGIN_ENABLED=true
WD_ADMIN_EMAIL=
WD_ADMIN_PASSWORD=
WD_API_COMPAT_DEFAULT=ragflow_0_27
WD_USER_DELETE_MODE=transfer
WD_USER_DELETE_TRANSFER_TO=
WD_EXPOSE_PROMPT=true
# Dopiski cytowań [ID:n] post-hoc, gdy odpowiedź modelu ich nie zawiera (M6b).
WD_POSTHOC_CITATIONS=true
# Limit tokenów katalogu dokumentów dopisywanego na końcu promptu czatu (mapa bazy wiedzy, K21 §3);
# 0 = katalog wyłączony (czat działa jak przed v1.3).
WD_CHAT_KB_CATALOG_TOKENS=1500
# Limit tokenów pełnej mapy bazy przy pytaniu o samą bazę (K21 §4); mapa wchodzi w miejsce katalogu;
# 0 = mapa wyłączona (pytanie o bazę idzie zwykłą ścieżką + katalog).
WD_CHAT_KB_MAP_TOKENS=6000
# --- LLM ---
WD_LLM_BASE_URL=
WD_LLM_API_KEY=
WD_LLM_DEFAULT_CHAT=openai/gpt-4.1-mini
WD_LLM_DEFAULT_EMBEDDING=openai/text-embedding-3-large
WD_LLM_DEFAULT_RERANK=
WD_LLM_DEFAULT_VLM=openai/gpt-4.1-mini
WD_LLM_TIMEOUT_S=120
WD_LLM_MAX_RETRIES=3
WD_EMBED_BATCH_SIZE=64
# Liczba równoległych zapytań wizji/OCR w jednym zadaniu (domyślnie 3), gdy model nie ma `extra.max_concurrency`;
# zakres 1–32. Nadpisuje ją pole „Równoległe zapytania" modelu (Ustawienia → Modele → Edytuj model).
WD_VLM_CONCURRENCY=3
# Liczba równoległych partii embeddingu w jednym zadaniu (domyślnie 4), gdy model nie ma `extra.max_concurrency`;
# zakres 1–32. Ograniczana limitami RPM/TPM dostawcy — przy 429 worker ponawia.
WD_EMBED_CONCURRENCY=4
WD_RETRIEVAL_FUSION=weighted
WD_MIN_VECTOR_SIM=0.25
WD_MIN_RERANK_SCORE=0.1
# --- worker ---
WD_WORKER_CONCURRENCY=2
WD_WORKER_POLL_S=1.0
WD_TASK_HEARTBEAT_S=15
WD_TASK_STALE_S=120
WD_WORKER_ENABLE_SCHEDULER=true
# Limit czasu parsowania jednego dokumentu w sekundach (H14); po przekroczeniu dokument dostaje status błędu.
WD_PARSE_TIMEOUT_S=1800
# Liczba procesów puli konwersji dokumentów workera (kontrakt C4); puste = Settings: min(4, liczba rdzeni).
# Każdy proces zużywa ok. 0,56 GB RSS przy dużym PDF (E5-H2) — dopasuj do WD_WORKER_MEM_LIMIT.
WD_PARSE_PROCESSES=
# Odstęp przeglądu workera uzupełniającego spisy treści dokumentów bez profilu (K21 §2 p. 4),
# w sekundach; 0 wyłącza przegląd.
WD_OUTLINE_SWEEP_S=600
# --- OCR ---
WD_OCR_ENGINE=vlm
WD_OCR_LANGS=pol+eng
# Ułamek VRAM rezerwowany przez usługę `ocr` (vLLM, Xiaomi-OCR-0; tylko compose, profil `ocr`)
# WD_OCR_GPU_UTIL=0.5
# Maks. liczba jednocześnie obsługiwanych sekwencji `--max-num-seqs` usługi `ocr` (tylko compose, profil `ocr`).
# Model hybrydowy Mamba (Qwen3.5) przy `WD_OCR_GPU_UTIL` < ~0,4 bez tej flagi nie startuje
# (`max_num_seqs (256) exceeds available Mamba cache blocks`). Ustaw wartość nie mniejszą niż liczba
# „Równoległych zapytań" modelu OCR (Ustawienia → Modele) — kompromis VRAM a współbieżnością.
# WD_OCR_MAX_NUM_SEQS=32
# --- limity i metryki ---
# Limit rozmiaru paczki KB `.wdkb.zip` (eksport i import) oraz sumy rozpakowanych wpisów (K19 §6).
WD_EXPORT_MAX_BYTES=2147483648
WD_RATE_LIMIT_LOGIN=10/min
WD_METRICS_ENABLED=false
# --- funkcje ---
WD_FEATURE_AGENTS=false
WD_FEATURE_MEMORY=false

# Integracje (M9, K12, DECISIONS Q9)
WD_INTEGRATIONS_ENABLED=true
WD_INTEGRATIONS_TICK_SECONDS=30
WD_INTEGRATIONS_STALE_LOCK_MINUTES=15
WD_INTEGRATIONS_WAIT_TIMEOUT=600
WD_INTEGRATIONS_CANCEL_WAIT=10
WD_INTEGRATIONS_EVENTS_RETENTION_DAYS=90
WD_SP_DELETE_DOCS_ON_INTEGRATION_DELETE=false
WD_SP_PURGE_EXCLUDED_CONTAINERS=false
WD_SP_LINK_CACHE_TTL_SECONDS=3600
# Bazowy URL logowania Microsoft (endpoint tokenu); zmieniany tylko w testach (stub fake-graph). Bez końcowego "/".
WD_SP_LOGIN_BASE_URL=https://login.microsoftonline.com
# Bazowy URL Microsoft Graph; zmieniany tylko w testach (stub fake-graph). Bez końcowego "/".
WD_SP_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# --- tylko compose ---
WD_DB_ROOT_PASSWORD=
TZ=
PORT=
WD_API_UPSTREAM=
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
DOCS_URL=
FEATURE_AGENT=
FEATURE_MEMORY=
FEATURE_SEARCH=
FEATURE_FILES=
# Limit pamięci kontenera workera (compose deploy.resources.limits.memory); sizing w runbooku
WD_WORKER_MEM_LIMIT=4g
# Nazwa sieci Docker stosu (domyślnie wd-net); inna nazwa pozwala uruchomić równolegle kilka stosów
WD_NET_NAME=

# --- MCP (serwer MCP, profil compose `mcp`; K17 §1) ---
# Zmienne tylko compose / serwera MCP — `Settings` ich nie czyta, dlatego zostają zakomentowane
# (sekcja „tylko compose” trzyma zamknięty zbiór zmiennych pod `backend/tests/unit/core/test_env_example.py`).
# Wartości domyślne wystarczają: `web` sięga do `WD_MCP_UPSTREAM`, a `python -m app.mcp` czyta port i bazę API WD.
# WD_MCP_PORT=9382
# WD_MCP_API_BASE=http://api:8000/api/v1
# WD_MCP_MEM_LIMIT=256m
# WD_MCP_UPSTREAM=http://mcp:9382

# --- SearXNG (wyszukiwanie w internecie dla Agenta, usługa compose `searxng`; K18 §5, Q23 b) ---
# Zmienne tylko compose — `Settings` ich nie czyta, dlatego zostają zakomentowane (sekcja „tylko compose”
# trzyma zamknięty zbiór zmiennych pod `backend/tests/unit/core/test_env_example.py`).
# `WD_SEARXNG_MEM_LIMIT` — limit pamięci kontenera `searxng` (domyślnie 256m); zmierzony zapas jest spory,
# podnoś tylko przy nietypowym obciążeniu wyszukiwaniem.
# `SEARXNG_SECRET` — sekret SearXNG (nadpisuje `server.secret_key`); **pusty = pochodna `WD_SECRET_KEY`**,
# więc istniejąca instalacja nie potrzebuje nowej zmiennej. Ustaw jawnie tylko, gdy chcesz rotować sekret
# wyszukiwarki niezależnie od reszty stosu.
# WD_SEARXNG_MEM_LIMIT=256m
# SEARXNG_SECRET=

# --- tylko tools/dev/live.sh ---
# Sędzia wdeval (DECISIONS Q2): OpenRouter, dostawca z.ai bez fallbacków
WD_JUDGE_BASE_URL=https://openrouter.ai/api/v1
WD_JUDGE_API_KEY=
WD_JUDGE_MODEL=z-ai/glm-5.3-flash
WD_JUDGE_PROVIDER=z-ai/fp8
# Tenant testowy SharePoint (DECISIONS Q4)
WD_SP_TEST_TENANT_ID=
WD_SP_TEST_CLIENT_ID=
WD_SP_TEST_CLIENT_SECRET=
WD_SP_TEST_SITE_URL=
